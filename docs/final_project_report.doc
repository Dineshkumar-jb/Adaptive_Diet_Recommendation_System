  <tr><td><strong>Precision@5</strong></td><td>0.61</td><td><strong>0.92</strong></td><td>+0.31</td><td><strong>+50.8%</strong></td></tr>
  <tr><td><strong>Recall@5</strong></td><td>0.54</td><td><strong>0.88</strong></td><td>+0.34</td><td><strong>+62.9%</strong></td></tr>
  <tr><td><strong>NDCG@5</strong></td><td>0.59</td><td><strong>0.91</strong></td><td>+0.32</td><td><strong>+54.2%</strong></td></tr>
